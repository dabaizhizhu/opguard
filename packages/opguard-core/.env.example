# 复制本文件为 .env 后填入真实值，勿把 .env 提交进仓库。
# 用法：cp .env.example .env  → 填下面几项 → from opguard import build_prod_guard
# build_prod_guard() 启动时会自动 load_dotenv()，已存在的环境变量不会被覆盖。
# 缺 HMAC / L2 / 语义向量配置时生产装配会拒启，不会静默回退开发默认实现。

# 必填：HMAC（票据 / 裁决 / 许可共享密钥；可用：openssl rand -hex 32）
OPGUARD_HMAC_SECRET=

# L2 Jev：二选一
# 方案 A 自建审查服务（HttpJevAuditor）
OPGUARD_JEV_URL=
# 方案 B OpenAI 兼容 LLM 审查（LLMJevAuditor）
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPGUARD_LLM_MODEL=gpt-4o-mini
# OPGUARD_LLM_TIMEOUT_S=10

# 语义向量：有 OPENAI_API_KEY 时可用远程嵌入；否则设 local（需 embeddings extra）
# OPGUARD_EMBEDDING=local
# OPGUARD_EMBEDDING_MODEL=text-embedding-3-small
# OPGUARD_EMBEDDING_TIMEOUT_S=5

# 可选：人工审批标记（0/1，仅写入审计记录，不会暂停流水线等待人工）
# OPGUARD_HITL=0

